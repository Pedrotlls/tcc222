# Copie para application.properties, nesta pasta ao lado do pom.xml.
# Preencha os dados do SQL Server do computador. Não envie o arquivo preenchido ao Git.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=apibbs;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=PREENCHA_COM_A_SENHA_DO_SQL_SERVER
BBS_ADMIN_EMAIL=admin@bbs.local
# Primeiro acesso: defina uma senha sua com 12 a 64 caracteres.
# Admin já cadastrado: pode deixar vazio; não redefine a senha existente.
BBS_ADMIN_PASSWORD=
# Em uma publicação HTTPS, altere para true. Na rede local HTTP, mantenha false.
BBS_COOKIE_SECURE=false
